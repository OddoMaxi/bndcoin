// Bory & Norbert — V1 platform data model.
//
// Modular monolith. Money/rate columns are DECIMAL(38,18); application code goes
// through @bn/money (decimal.js) and quantises to asset scale before persisting.
// Append-only tables (LedgerEntry, LedgerJournal, TransactionEvent-style event
// tables, AuditLog) have no update/delete path in the service layer.
//
// The double-entry LEDGER is the source of financial truth. TreasuryAccount /
// InventoryLot balances are fast caches reconciled against the ledger.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===========================================================================
// Enums
// ===========================================================================

enum Role {
