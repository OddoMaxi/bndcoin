  OPERATIONS
  TREASURY
  COMPLIANCE
  CUSTOMER_SUPPORT
  EVENT_MANAGER
  FINANCE
  AUDITOR
  ORGANIZER
  SCANNER_OPERATOR
  CUSTOMER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING_KYC
  CLOSED
}

enum KycLevel {
  NONE
  BASIC
  FULL
}

enum KycStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum OtpChannel {
  SMS
  EMAIL
}

enum OtpPurpose {
