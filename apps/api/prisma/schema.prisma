  CONFIRMING
  CRYPTO_CONFIRMED
  GNF_RESERVED
  PAYOUT_PENDING
  PAYOUT_PROCESSING
  // terminal
  COMPLETED
  FAILED
  EXPIRED
  CANCELLED
  UNDER_REVIEW
  REFUNDED
}

enum ActorType {
