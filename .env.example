# ---------------------------------------------------------------------------
# Bory & Norbert — environment template. Copy to .env for local development.
# ---------------------------------------------------------------------------

# --- Shared / infra ---
NODE_ENV=development

# Postgres (compose service "postgres")
POSTGRES_USER=bn
POSTGRES_PASSWORD=bn_dev_password
POSTGRES_DB=bory_norbert
POSTGRES_PORT=5432

# Redis (compose service "redis")
REDIS_PORT=6379

# --- API (apps/api) ---
API_PORT=3001
# Connection string used by Prisma + the Nest app.
# When running the API on the host: host=localhost. Inside compose: host=postgres.
DATABASE_URL=postgresql://bn:bn_dev_password@localhost:5432/bory_norbert?schema=public
REDIS_URL=redis://localhost:6379

# Auth
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# Provider selection (only "mock" is implemented in this iteration)
PAYMENT_PROVIDER=mock
CRYPTO_PROVIDER=mock

# Dev-only endpoints that let an admin drive mock provider scenarios.
# MUST be false in any shared / production environment.
MOCK_PROVIDERS_ENABLED=true

# Flow timing (seconds)
PAYMENT_WINDOW_SECONDS=900
QUOTE_SWEEP_INTERVAL_SECONDS=15
CRYPTO_REQUIRED_CONFIRMATIONS=3

# Rate limiting (requests / window seconds)
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=120

CORS_ORIGIN=http://localhost:3000

# --- Web (apps/web) ---
WEB_PORT=3000
# Base URL the browser / Next server uses to reach the API.
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
# Surfaces the "simulate payment" controls in the tracking UI.
NEXT_PUBLIC_MOCK_ENABLED=true

# --- E2E (docker-compose.test.yml) ---
TEST_DATABASE_URL=postgresql://bn:bn_dev_password@localhost:5433/bory_norbert_test?schema=public
TEST_REDIS_URL=redis://localhost:6380
