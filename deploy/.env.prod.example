# Copy to deploy/.env and fill in. docker compose reads it automatically.

# Public HTTPS origin (must match the domain in ./Caddyfile).
PUBLIC_URL=https://rndcoin.koppoddo.cloud

# Postgres
POSTGRES_USER=bn
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=bory_norbert

# Auth secrets — generate with: openssl rand -hex 48
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me

# Iteration 1 ships only mock providers; keep true so the BUY flow is demoable.
MOCK_PROVIDERS_ENABLED=true
