# Copy to deploy/.env and fill in. docker compose reads it automatically.

# Public HTTPS origin (must match the domain in ./Caddyfile).
PUBLIC_URL=https://rndcoin.koppoddo.cloud

# Postgres
POSTGRES_USER=bn
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=bory_norbert

# Secrets — generate each with: openssl rand -hex 48
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
QR_SIGNING_SECRET=change-me

# --- Master safety switches ---
# Keep everything mock/false until real credentials & GSM hardware are wired.
REAL_MONEY_MODE=false
REAL_CRYPTO_MODE=false
ORANGE_MODE=mock          # mock | modem
OTP_MODE=mock             # mock | live
BLOCKCHAIN_PROVIDER=mock  # mock | live
MOCK_PROVIDERS_ENABLED=true   # exposes /mock/* admin simulation endpoints
